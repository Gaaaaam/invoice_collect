# 复制为 .env 后填写。docker compose 会自动读取该文件。
# 可选：指定部署镜像（不填则默认为 invoice-collect:latest）
# INVOICE_COLLECT_IMAGE=your-registry/invoice-collect:1.0.0

# 应用运行时会读取以下变量覆盖 config/models.yml（仅非空值生效）
INVOICE_COLLECT_LLM_BASE_URL=https://api.openai.com/v1
INVOICE_COLLECT_LLM_API_KEY=
INVOICE_COLLECT_LLM_MODEL=gpt-4o-mini
INVOICE_COLLECT_LLM_TIMEOUT=60

INVOICE_COLLECT_NUEXTRACT_HOST=host.docker.internal
INVOICE_COLLECT_NUEXTRACT_PORT=8080
INVOICE_COLLECT_NUEXTRACT_TIMEOUT=60
